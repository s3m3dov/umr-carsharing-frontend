# Google Maps API Key (required for Places Autocomplete and Maps)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# API Gateway base URL.
# Option A — point directly at the deployed gateway (simplest, works if CORS allows your origin):
#   VITE_API_BASE_URL=http://35.186.208.67
# Option B — use Vite dev proxy (see vite.config.ts server.proxy, avoids CORS entirely). Set empty:
#   VITE_API_BASE_URL=
# Production: set to the deployed gateway URL.
#   VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=http://35.186.208.67
