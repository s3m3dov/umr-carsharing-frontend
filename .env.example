# Google Maps API Key (required for Places Autocomplete and Maps)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# API Gateway base URL.
# PRODUCTION (Vercel): Set EMPTY to use the Vercel proxy (avoids "Mixed Content" HTTP/HTTPS issues).
#   VITE_API_BASE_URL=
#
# DEVELOPMENT (Local): Set EMPTY to use the Vite dev proxy.
#   VITE_API_BASE_URL=
#
# CUSTOM DOMAIN: If you have a real HTTPS domain for your backend, set it here:
#   VITE_API_BASE_URL=https://api.your-domain.com

VITE_API_BASE_URL=
